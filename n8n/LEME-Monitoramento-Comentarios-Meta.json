    {"id":"client-pages","name":"Meta — listar páginas dos clientes","type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[10,1030],"onError":"continueRegularOutput","parameters":{"url":"={{'https://graph.facebook.com/' + $('CONFIGURAÇÃO META — REAPROVEITA CREDENCIAL').first().json.graph_version + '/' + $('CONFIGURAÇÃO META — REAPROVEITA CREDENCIAL').first().json.business_id + '/client_pages'}}","authentication":"genericCredentialType","genericAuthType":"httpQueryAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"id,name,access_token,instagram_business_account{id,username,name}"},{"name":"limit","value":"200"}]},"options":{}},"credentials":{"httpQueryAuth":{"id":"VweUG1nojlmkiIWW","name":"Meta LEME Query"}}},
    {"id":"consolidate-assets","name":"Consolidar ativos e tokens","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,1030],"parameters":{"jsCode":"const read=name=>{try{return $(name).first().json.data||[];}catch{return [];}}; const pages=[...read('Meta — listar páginas próprias'),...read('Meta — listar páginas dos clientes')]; const unique=new Map(); for(const page of pages){if(!page?.id)continue; const current=unique.get(String(page.id))||{}; unique.set(String(page.id),{facebook_page_id:String(page.id),facebook_page_name:String(page.name||current.facebook_page_name||''),instagram_account_id:String(page.instagram_business_account?.id||current.instagram_account_id||''),instagram_username:String(page.instagram_business_account?.username||current.instagram_username||''),page_access_token:String(page.access_token||current.page_access_token||'')});} const assets=[...unique.values()]; if(!assets.length)throw new Error('A credencial não retornou páginas. Atribua as páginas próprias e de parceiros ao usuário do sistema ligado à credencial Meta LEME Query.'); const missingToken=assets.filter(item=>!item.page_access_token); if(missingToken.length)throw new Error('A Meta listou '+assets.length+' páginas, mas não devolveu Page Access Token para '+missingToken.length+'. Atribua às páginas as tarefas MANAGE ou MODERATE para o usuário do sistema e execute novamente.'); return [{json:{assets,total:assets.length,with_instagram:assets.filter(item=>item.instagram_account_id).length}}];"}},
    {"id":"sync-system","name":"Enviar ativos ao Sistema LEME","type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[520,1030],"parameters":{"method":"POST","url":"={{$('CONFIGURAÇÃO META — REAPROVEITA CREDENCIAL').first().json.leme_api_url + '/api/automations/social-comments/meta-assets/sync'}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-LEME-N8N-KEY","value":"={{$env.N8N_LEME_SECRET}}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({assets:$json.assets,auto_subscribe:true})}}","options":{}}},
    {"id":"sync-summary","name":"Sincronização Meta concluída","type":"n8n-nodes-base.code","typeVersion":2,"position":[780,1030],"parameters":{"jsCode":"const result=$json; const failed=(result.subscriptions||[]).filter(item=>!item.ok); return [{json:{ok:true,ativos_salvos:result.saved||0,clientes_associados:result.matched||0,inscricoes_ativas:(result.subscriptions||[]).filter(item=>item.ok).length,falhas:failed.map(item=>({client_id:item.client_id,error:item.error}))}}];"}},
    {"id":"sync-note","name":"LEIA — CREDENCIAL META REUTILIZADA","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-1240,1260],"parameters":{"width":2020,"height":300,"content":"## Sincronização automática sem token no EasyPanel\nEste fluxo reutiliza a credencial **Meta LEME Query** já usada no relatório de Instagram. Ele valida permissões, lista páginas próprias e de clientes, envia os ativos ao Sistema LEME, associa automaticamente pelo @Instagram e inscreve as páginas nos webhooks.\n\nSe o nó de permissões apontar uma permissão ausente, gere novamente o token da MESMA credencial adicionando: `pages_show_list`, `pages_manage_metadata`, `pages_read_engagement` e `instagram_manage_comments`.\n\nNo aplicativo LEME Insights, configure uma única vez o callback de Webhooks e assine o campo Instagram `comments` e o objeto Page `feed`."}}
