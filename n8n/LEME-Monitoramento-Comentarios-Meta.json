    {"id":"apply-publication-link","name":"Aplicar link da publicação","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,120],"parameters":{"jsCode":"const event=$('Preparar registro').item.json; const meta=$json||{}; const candidate=String(meta.permalink||meta.permalink_url||event.publication_url||'').trim(); let publicationUrl=''; if(candidate){try{const parsed=new URL(candidate); if(['http:','https:'].includes(parsed.protocol)) publicationUrl=parsed.toString();}catch{publicationUrl='';}} return [{json:{...event,publication_url:publicationUrl}}];"}},
