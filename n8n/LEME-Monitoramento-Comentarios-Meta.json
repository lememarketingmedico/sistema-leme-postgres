    {"id":"retry-items","name":"Preparar retries","type":"n8n-nodes-base.code","typeVersion":2,"position":[-480,620],"parameters":{"jsCode":"const cfg=$('CONFIGURAÇÃO — EDITE AQUI').first().json; return ($json.comments||[]).map(c=>{const zone=cfg.timezone; const date=new Intl.DateTimeFormat('pt-BR',{timeZone:zone,dateStyle:'short',timeStyle:'short'}).format(new Date(c.occurred_at)); const network=c.provider==='instagram'?'Instagram':'Facebook'; const author=c.author_username?'@'+c.author_username.replace(/^@/,''):(c.author_name||'Não informado'); const link=c.publication_url?'\\n\\n🔗 *Ver publicação:*\\n'+c.publication_url:''; return {json:{...c,text:`💬 *NOVO COMENTÁRIO | LEME*\\n\\n👤 *Cliente:* ${c.nome_cliente}\\n\\n📱 *Rede social:* ${network}\\n\\n🙋 *Autor:* ${author}\\n\\n📝 *Comentário:*\\n${c.message||'(sem texto)'}\\n\\n📅 *Data:* ${date}${link}`}};});"}},
    {"id":"retry-send","name":"Reenviar WhatsApp","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-220,620],"onError":"continueErrorOutput","parameters":{"method":"POST","url":"={{$('CONFIGURAÇÃO — EDITE AQUI').first().json.evolution_api_url + '/message/sendText/' + encodeURIComponent($('CONFIGURAÇÃO — EDITE AQUI').first().json.evolution_instance)}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{$env.EVOLUTION_API_KEY}}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({number:$('CONFIGURAÇÃO — EDITE AQUI').first().json.whatsapp_group_id,text:$json.text})}}","options":{}}},
    {"id":"retry-status","name":"Atualizar status do retry","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[40,560],"parameters":{"method":"POST","url":"={{$('CONFIGURAÇÃO — EDITE AQUI').first().json.leme_api_url + '/api/automations/social-comments/' + $('Preparar retries').item.json.id + '/delivery'}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-LEME-N8N-KEY","value":"={{$env.N8N_LEME_SECRET}}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({status:'sent',whatsapp_message_id:$json.key?.id||$json.messageId||''})}}","options":{}}},
