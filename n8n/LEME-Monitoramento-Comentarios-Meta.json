    {"id":"verify-hook","name":"Meta — Verificação GET","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1240,-320],"webhookId":"leme-meta-comments-verify","parameters":{"httpMethod":"GET","path":"leme-meta-comments","responseMode":"responseNode","options":{}}},
    {"id":"verify","name":"Validar challenge Meta","type":"n8n-nodes-base.code","typeVersion":2,"position":[-980,-320],"parameters":{"jsCode":"const q=$json.query||{}; const ok=String(q['hub.mode']||'')==='subscribe' && String(q['hub.verify_token']||'')===String($env.META_WEBHOOK_VERIFY_TOKEN||''); return [{json:{ok,challenge:String(q['hub.challenge']||'')}}];"}},
