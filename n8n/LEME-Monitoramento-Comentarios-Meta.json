    {"id":"route","name":"Evento Meta ou retry?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-860,120],"parameters":{"conditions":{"options":{"typeValidation":"loose","version":2},"conditions":[{"id":"raw","leftValue":"={{Boolean($json.rawBody)}}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},
    {"id":"signature","name":"Validar assinatura e normalizar","type":"n8n-nodes-base.code","typeVersion":2,"position":[-740,120],"parameters":{"jsCode":"const crypto=require('crypto'); const input=$input.first().json; const headers=input.headers||{}; const sig=String(headers['x-hub-signature-256']||headers['X-Hub-Signature-256']||''); const raw=typeof input.rawBody==='string'?input.rawBody:(input.rawBody?.data?Buffer.from(input.rawBody.data,'base64').toString('utf8'):''); if(!raw) throw new Error('O Webhook precisa fornecer rawBody para validação criptográfica.'); const expected='sha256='+crypto.createHmac('sha256',String($env.META_APP_SECRET||'')).update(raw).digest('hex'); const a=Buffer.from(sig),b=Buffer.from(expected); if(a.length!==b.length||!crypto.timingSafeEqual(a,b)) throw new Error('Assinatura Meta inválida.'); const body=JSON.parse(raw); const out=[]; for(const entry of body.entry||[]){for(const change of entry.changes||[]){const v=change.value||{}; if(body.object==='instagram'&&change.field==='comments'&&v.id){out.push({json:{provider:'instagram',account_id:String(entry.id||''),comment_id:String(v.id),post_id:String(v.media?.id||''),parent_comment_id:String(v.parent_id||''),author_id:String(v.from?.id||''),author_name:String(v.from?.username||''),author_username:String(v.from?.username||''),message:String(v.text||''),occurred_at:new Date(Number(entry.time||Date.now()/1000)*1000).toISOString(),publication_url:String(v.media?.permalink||'')}});} if(body.object==='page'&&change.field==='feed'&&v.item==='comment'&&v.verb==='add'){out.push({json:{provider:'facebook',account_id:String(entry.id||''),comment_id:String(v.comment_id||v.id||''),post_id:String(v.post_id||''),parent_comment_id:String(v.parent_id||''),author_id:String(v.from?.id||''),author_name:String(v.from?.name||''),author_username:'',message:String(v.message||''),occurred_at:v.created_time?new Date(Number(v.created_time)*1000).toISOString():new Date().toISOString(),publication_url:String(v.permalink_url||'')}});}}} return out;"}},
    {"id":"ack","name":"Responder Meta 200","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-740,340],"parameters":{"respondWith":"json","responseBody":"={{ {received:true} }}","options":{"responseCode":200}}},
    {"id":"resolve","name":"Identificar cliente no LEME","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-470,120],"parameters":{"url":"={{$('CONFIGURAÇÃO — EDITE AQUI').first().json.leme_api_url + '/api/automations/social-comments/resolve'}}","sendQuery":true,"queryParameters":{"parameters":[{"name":"provider","value":"={{$json.provider}}"},{"name":"account_id","value":"={{$json.account_id}}"}]},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-LEME-N8N-KEY","value":"={{$env.N8N_LEME_SECRET}}"}]},"options":{}}},
    {"id":"prepare","name":"Preparar registro","type":"n8n-nodes-base.code","typeVersion":2,"position":[-230,120],"parameters":{"jsCode":"const event=$('Validar assinatura e normalizar').item.json; const resolved=$json; return [{json:{...event,client_id:String(resolved.client?.id||''),client_name:String(resolved.client?.name||'Cliente LEME'),monitor:resolved.monitor||{}}}];"}},
    {"id":"register","name":"Registrar e deduplicar","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[20,120],"parameters":{"method":"POST","url":"={{$('CONFIGURAÇÃO — EDITE AQUI').first().json.leme_api_url + '/api/automations/social-comments/register'}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-LEME-N8N-KEY","value":"={{$env.N8N_LEME_SECRET}}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify($json)}}","options":{}}},
    {"id":"notify-if","name":"Deve notificar?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[260,120],"parameters":{"conditions":{"options":{"typeValidation":"strict","version":2},"conditions":[{"id":"n","leftValue":"={{$json.should_notify}}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},
    {"id":"format","name":"Formatar WhatsApp","type":"n8n-nodes-base.code","typeVersion":2,"position":[500,60],"parameters":{"jsCode":"const e=$('Preparar registro').item.json; const r=$json; const zone=$('CONFIGURAÇÃO — EDITE AQUI').first().json.timezone||'America/Sao_Paulo'; const date=new Intl.DateTimeFormat('pt-BR',{timeZone:zone,dateStyle:'short',timeStyle:'short'}).format(new Date(e.occurred_at)); const network=e.provider==='instagram'?'Instagram':'Facebook'; const author=e.author_username?'@'+e.author_username.replace(/^@/,''):(e.author_name||'Não informado'); const link=e.publication_url?'\\n\\n🔗 *Ver publicação:*\\n'+e.publication_url:''; return [{json:{...e,comment_record_id:r.comment.id,text:`💬 *NOVO COMENTÁRIO | LEME*\\n\\n👤 *Cliente:* ${e.client_name}\\n\\n📱 *Rede social:* ${network}\\n\\n🙋 *Autor:* ${author}\\n\\n📝 *Comentário:*\\n${e.message||'(sem texto)'}\\n\\n📅 *Data:* ${date}${link}`}}];"}},
    {"id":"evolution","name":"Enviar para grupo WhatsApp","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[750,60],"onError":"continueErrorOutput","parameters":{"method":"POST","url":"={{$('CONFIGURAÇÃO — EDITE AQUI').first().json.evolution_api_url + '/message/sendText/' + encodeURIComponent($('CONFIGURAÇÃO — EDITE AQUI').first().json.evolution_instance)}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{$env.EVOLUTION_API_KEY}}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({number:$('CONFIGURAÇÃO — EDITE AQUI').first().json.whatsapp_group_id,text:$json.text})}}","options":{}}},
