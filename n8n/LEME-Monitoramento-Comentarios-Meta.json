    {"id":"check-permissions","name":"Conferir permissões para comentários","type":"n8n-nodes-base.code","typeVersion":2,"position":[-490,1030],"parameters":{"jsCode":"const rows=Array.isArray($json.data)?$json.data:[]; const granted=new Set(rows.filter(item=>item.status==='granted').map(item=>String(item.permission||''))); const required=['pages_show_list','pages_manage_metadata','pages_read_engagement','instagram_manage_comments']; const missing=required.filter(permission=>!granted.has(permission)); if(missing.length){throw new Error('A credencial Meta LEME Query já funciona para Insights, mas ainda não tem as permissões necessárias para comentários: '+missing.join(', ')+'. Gere novamente o token da MESMA credencial adicionando apenas essas permissões.');} return [{json:{permissions_ok:true,granted:[...granted]}}];"}},
