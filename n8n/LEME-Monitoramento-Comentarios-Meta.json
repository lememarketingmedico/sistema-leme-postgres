    {"id":"format","name":"Formatar WhatsApp","type":"n8n-nodes-base.code","typeVersion":2,"position":[980,60],"parameters":{"jsCode":"const e=$('Aplicar link da publicação').item.json; const r=$json; const zone=$('CONFIGURAÇÃO — EDITE AQUI').first().json.timezone||'America/Sao_Paulo'; const date=new Intl.DateTimeFormat('pt-BR',{timeZone:zone,dateStyle:'short',timeStyle:'short'}).format(new Date(e.occurred_at)); const network=e.provider==='instagram'?'Instagram':'Facebook'; const author=e.author_username?'@'+e.author_username.replace(/^@/,''):(e.author_name||'Não informado'); const link=e.publication_url?'\\n\\n🔗 *Ir à publicação:*\\n'+e.publication_url:''; return [{json:{...e,comment_record_id:r.comment.id,text:`💬 *NOVO COMENTÁRIO | LEME*\\n\\n👤 *Cliente:* ${e.client_name}\\n\\n📱 *Rede social:* ${network}\\n\\n🙋 *Autor:* ${author}\\n\\n📅 *Data:* ${date}${link}\\n\\n📝 *Comentário:*\\n${e.message||'(sem texto)'}`}}];"}},
