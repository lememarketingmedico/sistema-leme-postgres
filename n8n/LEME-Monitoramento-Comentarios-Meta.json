    {"id":"signature","name":"Validar assinatura e normalizar","type":"n8n-nodes-base.code","typeVersion":2,"position":[-740,120],"parameters":{"jsCode":"const crypto=require('crypto'); const input=$input.first().json; const headers=input.headers||{}; const sig=String(headers['x-hub-signature-256']||headers['X-Hub-Signature-256']||''); const raw=typeof input.rawBody==='string'?input.rawBody:(input.rawBody?.data?Buffer.from(input.rawBody.data,'base64').toString('utf8'):''); if(!raw) throw new Error('O Webhook precisa fornecer rawBody para validação criptográfica.'); const expected='sha256='+crypto.createHmac('sha256',String($env.META_APP_SECRET||'')).update(raw).digest('hex'); const a=Buffer.from(sig),b=Buffer.from(expected); if(a.length!==b.length||!crypto.timingSafeEqual(a,b)) throw new Error('Assinatura Meta inválida.'); const body=JSON.parse(raw); const out=[]; for(const entry of body.entry||[]){for(const change of entry.changes||[]){const v=change.value||{}; if(body.object==='instagram'&&change.field==='comments'&&v.id){out.push({json:{provider:'instagram',account_id:String(entry.id||''),comment_id:String(v.id),post_id:String(v.media?.id||''),parent_comment_id:String(v.parent_id||''),author_id:String(v.from?.id||''),author_name:String(v.from?.username||''),author_username:String(v.from?.username||''),message:String(v.text||''),occurred_at:new Date(Number(entry.time||Date.now()/1000)*1000).toISOString(),publication_url:String(v.media?.permalink||'')}});} if(body.object==='page'&&change.field==='feed'&&v.item==='comment'&&v.verb==='add'){out.push({json:{provider:'facebook',account_id:String(entry.id||''),comment_id:String(v.comment_id||v.id||''),post_id:String(v.post_id||''),parent_comment_id:String(v.parent_id||''),author_id:String(v.from?.id||''),author_name:String(v.from?.name||''),author_username:'',message:String(v.message||''),occurred_at:v.created_time?new Date(Number(v.created_time)*1000).toISOString():new Date().toISOString(),publication_url:String(v.permalink_url||'')}});}}} return out;"}},
