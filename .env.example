N8N_ANALYTICS_REPORT_WEBHOOK=https://n8n.adati.app.br/webhook/leme-analytics-report
# Use exatamente o mesmo valor na variável N8N_LEME_SECRET do serviço n8n.
N8N_LEME_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Mantém as Keys dos plugins criptografadas no PostgreSQL. Não altere depois de começar a usar.
CLIENT_INTEGRATION_ENCRYPTION_KEY=troque_por_outra_chave_longa_e_estavel
