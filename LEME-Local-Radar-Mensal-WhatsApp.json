      "name": "Webhook Local Radar mensal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        40
      ],
      "webhookId": "leme-local-radar-mensal"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-secret",
              "name": "n8n_leme_secret",
              "value": "COLE_AQUI_O_MESMO_N8N_LEME_SECRET_DO_BACKEND",
              "type": "string"
            },
            {
              "id": "cfg-group",
              "name": "grupo_leme",
              "value": "COLE_AQUI_O_ID_DO_GRUPO_LEME@g.us",
              "type": "string"
            },
            {
              "id": "cfg-instance",
              "name": "evolution_instance",
